{
  "$schema": "https://railway.app/railway.schema.json",
  "build": {
    "builder": "NIXPACKS",
    "buildCommand": "./build.sh"
  },
  "deploy": {
    "startCommand": "datasette camp_fin_2026.db --host 0.0.0.0 --port $PORT --plugins-dir plugins --template-dir templates --metadata metadata.json",
    "restartPolicyType": "ON_FAILURE",
    "restartPolicyMaxRetries": 3
  }
}
